#!/usr/bin/env python

Import('env')
Import('mu2e_helper')

helper = mu2e_helper(env)

rootlibs = env['ROOTLIBS']

# Calorimeter clients of the DQMHelpers core; the art modules that drive them
# live in Mu2e/DQM (offline) and otsdaq-mu2e-dqm (online).
helper.make_mainlib([
    'mu2e_DQMHelpers',
    'mu2e_RecoDataProducts',
    'mu2e_DataProducts',
    'art_Framework_Services_Registry',
    'art_root_io_tfile_support',
    'art_root_io_TFileService',
    'art_Utilities',
    'canvas',
    'MF_MessageLogger',
    'fhiclcpp',
    'fhiclcpp_types',
    'cetlib',
    'cetlib_except',
    rootlibs,
])

