import os
Import('env')
Import('mu2e_helper')

if env['TRIGGER'] == 'on':
    Return()

helper = mu2e_helper(env)
g4flags = []
g4includes = ['-I' + os.environ['G4INCLUDE'], '-I' + os.environ['G4INCLUDE'] + '/Geant4',
              '-L' + os.environ['G4LIB']]
if env['G4VG'] == 'on':
    g4flags.append('-DG4GEOM_USE_USOLIDS="all"')
    g4includes += ['-I' + os.environ['VECGEOM_INC'], '-I' + os.environ['VECCORE_INC']]

helper.make_plugins([
    'mu2e_Mu2eG4', 'mu2e_Mu2eG4Helper', 'mu2e_MCDataProducts', 'mu2e_DataProducts', 'mu2e_ConfigTools',
    'mu2e_GeometryService', 'mu2e_CosmicRayShieldGeom', 'mu2e_GeneralUtilities',
    'art_Framework_Core', 'art_Framework_Principal', 'art_Framework_Services_Registry',
    'art_root_io_TFileService', 'art_root_io_tfile_support', 'art_Persistency_Common',
    'art_Persistency_Provenance', 'art_Utilities', 'canvas', 'fhiclcpp', 'fhiclcpp_types',
    'cetlib', 'cetlib_except', 'MF_MessageLogger', 'CLHEP', 'Core', 'Tree',
    'G4global', 'G4geometry', 'G4materials', 'G4particles', 'G4track', 'G4processes',
    'G4intercoms', 'G4run', 'G4graphics_reps', 'tbb', 'pthread'
], [], [g4flags], [g4includes])
